    "@remotion/renderer": "4.0.543",
    "@remotion/three": "4.0.543",
    "astronomy-engine": "^2.1.19",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "kokoro-js": "^1.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.543",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "8.72.2",
    "vitest": "^5.1.0"
