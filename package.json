{
  "name": "content-creator",
  "private": true,
  "type": "module",
  "scripts": {
    "cc": "tsx src/cli/index.ts",
    "studio": "remotion studio video/index.tsx",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run validate:records",
    "test:bundle": "tsx scripts/bundle-smoke.ts",
    "validate:records": "tsx src/cli/index.ts validate"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/bundler": "4.0.543",
    "@remotion/cli": "4.0.543",
