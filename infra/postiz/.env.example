# Postiz stack configuration. `pnpm postiz:init` copies this to .env and fills the secrets.
# Never commit .env.

# --- Public URLs (what the browser and OAuth providers see) ---------------------------------
# Local only:      http://localhost:4007
# Public (needed for OAuth callbacks from YouTube/TikTok/Meta): https://postiz.your-domain.tld
MAIN_URL=http://localhost:4007
FRONTEND_URL=http://localhost:4007
NEXT_PUBLIC_BACKEND_URL=http://localhost:4007/api

# Host binding for the web port (keep 127.0.0.1 behind a reverse proxy)
POSTIZ_BIND=127.0.0.1
POSTIZ_PORT=4007

# --- Secrets (generated by postiz:init) -------------------------------------------------------
JWT_SECRET=
POSTIZ_DB_USER=postiz
POSTIZ_DB_PASSWORD=
POSTIZ_DB_NAME=postiz
TEMPORAL_DB_PASSWORD=

# --- Accounts ---------------------------------------------------------------------------------
# Register the first (admin) user, then set to true and `pnpm postiz:up` again.
DISABLE_REGISTRATION=false
API_LIMIT=30

# --- Platform apps (your own developer apps; see docs/publishing.md) --------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
# Facebook Pages + Instagram (Business, via Facebook login)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Instagram standalone login (optional alternative)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
